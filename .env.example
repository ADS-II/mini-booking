# ===================== CONFIGURACIÓN DE BASE DE DATOS (LOCAL) =====================
# Para desarrollo local con docker-compose.local.yml
POSTGRES_DB=mini_booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

# ===================== CONFIGURACIÓN DE SPRING (LOCAL) =====================
# URL para conexión interna entre contenedores (usa 'db' como hostname)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mini_booking_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ===================== CONFIGURACIÓN DE AUTH0 (LOCAL) =====================
# Para desarrollo local, usa valores dummy o configura con tus credenciales de Auth0
AUTH_JWT_ISSUER_URI=http://localhost/
AUTH_JWT_AUDIENCE=local-audience

# ===================== CONFIGURACIÓN DE BASE DE DATOS (PRODUCCIÓN) =====================
# Para producción con docker-compose.yml (Render u otro hosting)
# Descomenta y configura estos valores para producción:
# SPRING_DATASOURCE_DB_HOST=<tu-host-db>
# SPRING_DATASOURCE_DB_NAME=<nombre-db>
# SPRING_DATASOURCE_USERNAME=<usuario-db>
# SPRING_DATASOURCE_PASSWORD=<password-db>
# AUTH_JWT_ISSUER_URI=<tu-issuer-uri>
# AUTH_JWT_AUDIENCE=<tu-audience>
